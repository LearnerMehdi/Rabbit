# Repo-wide ignores. backend/.gitignore and frontend/.gitignore hold the
# per-package rules (book data, stress output, node_modules, dist).

# Secrets / local config
.env
.env.*
!.env.example
credentials*.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Vite
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/
npm-debug.log*

# Logs
*.log

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
